{
  "manifest_version": 3,
  "name": "Floating Video for Brave",
  "version": "0.3.0",
  "description": "Watch videos in native Picture-in-Picture, save playback, and optionally autosave WebM recordings when videos finish.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": { 
    "default_title": "Toggle video Picture-in-Picture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    } 
  },
  "background": { 
    "service_worker": "background.js" 
  }
}
